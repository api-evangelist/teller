          "name": "List Transactions",
          "request": {
            "name": "List Transactions",
            "description": {
              "content": "Returns a list of all transactions belonging to the specified account. Supports pagination and date range filtering.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "count",
                  "value": "<integer>",
                  "description": "Maximum number of transactions to return."
                },
                {
                  "disabled": false,
                  "key": "from_id",
                  "value": "<string>",
                  "description": "Paginate backward from this transaction ID."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Filter transactions on or after this ISO 8601 date."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "Filter transactions on or before this ISO 8601 date."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) The account identifier."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
